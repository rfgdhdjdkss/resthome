<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinyang.resthome.mapper.RoomsMapper">

    <resultMap id="BaseResultMap" type="com.jinyang.resthome.pojo.Rooms">
            <id property="room_id" column="room_id" jdbcType="BIGINT"/>
            <result property="floor" column="floor" jdbcType="INTEGER"/>
            <result property="room_number" column="room_number" jdbcType="VARCHAR"/>
            <result property="room_type" column="room_type" jdbcType="VARCHAR"/>
            <result property="price" column="price" jdbcType="DOUBLE"/>
    </resultMap>

    <sql id="Base_Column_List">
        room_id,floor,room_number,
        room_type,price
    </sql>
    <select id="selectForBedRoom" resultType="com.jinyang.resthome.pojo.vo.BedRoomVo">
        SELECT
            r.room_number,
            b.bed_number,
            b.bed_id
        FROM
            rooms r
                JOIN
            beds b ON r.room_number = b.room_number
        WHERE
            r.room_type = #{0} AND b.is_occupied = 0
        ORDER BY
            r.room_id
            LIMIT 1;
    </select>
    <select id="selectSpaceRoomNumber" resultType="java.lang.Integer">
        SELECT
            COUNT(DISTINCT r.room_id) AS room_count
        FROM
            rooms r
                JOIN
            beds b ON r.room_number = b.room_number
        WHERE
            b.is_occupied = 0;
    </select>
</mapper>
